<?php

// Flags of this site only, written by ee (Admin_Tools_Command::CONTAINER_DATA_DIR); the EE database is not mounted here.
$site_data_file = '/etc/easyengine/admin-tools/site.json';
$site_flags     = is_readable( $site_data_file ) ? json_decode( (string) file_get_contents( $site_data_file ), true ) : null;
if ( ! is_array( $site_flags ) ) {
	$site_flags = array();
}

$scan_dir = '/var/www/htdocs/ee-admin';
$scan     = scandir( $scan_dir );
$scan     = array_diff( $scan, [ '.', '..', 'index.php' ] );

$tools = array_merge( $scan, [ 'nginx_status', 'ping', 'status' ] );
if ( ! empty( $site_flags['mailhog'] ) ) {
	$tools[] = 'mailhog';
}
sort( $tools );

if ( empty( $site_flags['page_cache'] ) ) {
	$tools = array_diff( $tools, [ 'pra' ] );
}

foreach ( $tools as $tool ) {
	$tool = htmlspecialchars( $tool, ENT_QUOTES );
	echo '<a href="' . $tool . '">' . $tool . '</a><br/>';
}
